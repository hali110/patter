#!/bin/sh
# dictate — local hold-to-talk dictation for macOS. See CLAUDE.md for the rules.
#
#   dictate start | stop | build | doctor | test | bench | log
#   dictate refine [text] restructure text through the local LLM (stdin if no arg)
#   dictate pull-model    download the ~4.7GB refine model
#   dictate               terminal fallback loop (Enter records, Enter stops)
SRC="$0"; [ -L "$SRC" ] && SRC="$(readlink "$SRC")"
DIR="$(cd "$(dirname "$SRC")" && pwd)"
MODEL="$DIR/models/ggml-large-v3-turbo.bin"
REFINE_MODEL="$DIR/models/refine-q4.gguf"
REFINE_URL="https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF/resolve/main/Qwen2.5-7B-Instruct-Q4_K_M.gguf"
APP="$DIR/DictateDaemon.app"
LOG="$DIR/daemon.log"
# Everything this tool produces stays inside the checkout — logs, scratch audio,
# models. Nothing in /tmp: a server that dies at load leaves its reason in a file
# that is still there tomorrow, next to the code that started it.
SERVERLOG="$DIR/servers.log"
PORT=8090
REFINE_PORT=8091
TAB="$(printf '\t')"

server_up() { curl -s -o /dev/null --max-time 0.3 "http://127.0.0.1:$PORT/"; }
refine_up() { curl -s -o /dev/null --max-time 0.3 "http://127.0.0.1:$REFINE_PORT/health"; }

case "$1" in

stop)
  pkill -f "dictate-daemon" 2>/dev/null && echo "daemon stopped" || echo "daemon not running"
  pkill -f "whisper-server -m" 2>/dev/null && echo "whisper-server stopped (~2GB freed)" || echo "server not running"
  pkill -f "llama-server -m" 2>/dev/null && echo "llama-server stopped (~5GB freed)" || echo "refine server not running"
  ;;

pull-model)
  # One command, not a README curl incantation. Resumable: a 4.7GB download over a
  # bad connection should not have to start again.
  [ -f "$REFINE_MODEL" ] && { echo "already have $(du -h "$REFINE_MODEL" | cut -f1) at models/refine-q4.gguf"; exit 0; }
  mkdir -p "$DIR/models"
  echo "downloading Qwen2.5-7B-Instruct Q4_K_M (~4.7GB) — resumable, ctrl-C is safe"
  curl -L --retry 3 -C - -o "$REFINE_MODEL.part" "$REFINE_URL" || { echo "download failed"; exit 1; }
  mv "$REFINE_MODEL.part" "$REFINE_MODEL"
  echo "done — restart to load it: dictate stop && dictate start"
  ;;

refine)
  refine_up || { echo "llama-server not running — dictate start (or: dictate pull-model)" >&2; exit 1; }
  if [ -n "$2" ]; then printf '%s' "$2"; else cat; fi | sh "$DIR/refine.sh"
  echo
  ;;

start|daemon)
  pgrep -f "dictate-daemon" >/dev/null && { echo "already running (mic icon in menu bar)"; exit 0; }
  [ -x "$APP/Contents/MacOS/dictate-daemon" ] || { echo "not built — run: dictate build"; exit 1; }
  # Via LaunchServices, not as a shell child: `open` makes the daemon its own TCC
  # responsible process, so the grants on the app apply. A terminal-spawned child is
  # attributed to the terminal instead and the grants are ignored.
  # Remember where the log ended so we report *this* run's startup lines, not the
  # last one's — the permission checks land ~2s in, well after `open` returns.
  before=$(wc -l < "$LOG" 2>/dev/null || echo 0)
  open -g "$APP"
  i=0
  while [ "$i" -lt 40 ]; do
    tail -n "+$((before+1))" "$LOG" 2>/dev/null | grep -q "capture:" && break
    sleep 0.2; i=$((i+1))
  done
  if pgrep -f "dictate-daemon" >/dev/null; then
    echo "mic icon in menu bar — hold right ⌥ to dictate, right ⌘ to dictate + restructure"
    tail -n "+$((before+1))" "$LOG" | grep -E "accessibility:|input monitoring:|microphone:|capture:" \
      | sed -E 's/^[^ ]+ /  /; s/(.{100}).*/\1…/'
  else
    echo "daemon failed to start:"; tail -5 "$LOG"
  fi
  ;;

build)
  echo "compiling..."
  swiftc -O "$DIR"/daemon/*.swift -o "$APP/Contents/MacOS/dictate-daemon" || exit 1
  codesign -s - -f "$APP" >/dev/null 2>&1 || { echo "codesign failed"; exit 1; }
  echo "built + signed: $(du -h "$APP/Contents/MacOS/dictate-daemon" | cut -f1) binary"
  # Restart only a daemon running from THIS checkout. Building in a worktree used to
  # pkill the daemon the other checkout was running and put this build in its place —
  # silently swapping the binary behind a working production setup.
  running=$(pgrep -f "dictate-daemon" | head -1)
  running_app=$(ps -o command= -p "${running:-0}" 2>/dev/null)
  case "$running_app" in
    "$APP"*)
      pkill -f "$APP/Contents/MacOS/dictate-daemon"; sleep 1; open -g "$APP"; sleep 1
      echo "daemon restarted" ;;
    "") ;;
    *)  echo "note: a daemon from another checkout is running and was left alone:"
        echo "      ${running_app%%/Contents*}"
        echo "      to run THIS build instead: dictate stop && dictate start" ;;
  esac
  # Ad-hoc signing (codesign -s -) makes the designated requirement a bare cdhash,
  # which changes whenever the binary does. macOS therefore treats every rebuild as
  # a different app and ORPHANS the old grant rather than updating it. Signing with
  # a real or self-signed certificate would fix this permanently; until then, every
  # swiftc run costs a trip through System Settings.
  cat <<'WARN'
⚠  THIS REBUILD JUST INVALIDATED YOUR ACCESSIBILITY AND INPUT MONITORING GRANTS.
   Ad-hoc signing keys them to the binary's hash, so macOS now sees a new app.

   Re-grant, in this order, or the hotkey stays deaf:
     1. dictate permissions      (resets stale entries and reopens the panes)
     2. toggle DictateDaemon ON in Accessibility AND Input Monitoring
     3. dictate stop && dictate start

   Editing the `dictate` script, jargon.txt, replacements.sed or refine.txt does
   NOT require a rebuild and does NOT cost you the grants. Only daemon/*.swift does.
WARN
  ;;

permissions)
  # One command for the whole re-grant dance, because it has to be done in order
  # and every step of it has burned an hour at least once.
  LS=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  echo "1. stopping daemon and System Settings"
  pkill -f "dictate-daemon" 2>/dev/null
  killall "System Settings" 2>/dev/null
  sleep 1

  # A bundle registered from a deleted checkout makes System Settings bind the grant
  # to a path that no longer exists: the row never appears and no amount of
  # re-adding helps. Any DictateDaemon.app outside this directory is stale.
  echo "2. clearing stale LaunchServices registrations"
  "$LS" -dump 2>/dev/null | grep -oE '/[^ ]*DictateDaemon\.app' | sort -u | while read -r p; do
    case "$p" in
      "$APP") ;;
      *) echo "     unregistering stale: $p"; "$LS" -u "$p" 2>/dev/null ;;
    esac
  done
  "$LS" -f "$APP"

  echo "3. resetting TCC for com.haider.dictate"
  tccutil reset Accessibility com.haider.dictate >/dev/null 2>&1
  tccutil reset ListenEvent   com.haider.dictate >/dev/null 2>&1

  echo "4. starting daemon (it re-registers itself in both lists)"
  open -g "$APP"; sleep 4

  echo "5. opening the panes"
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
  echo
  echo "   Toggle ON the row named 'DictateDaemon' in BOTH:"
  echo "     • Accessibility     (lets it paste with ⌘V)"
  echo "     • Input Monitoring  (lets it hear the hotkey)"
  echo "   If a row is missing: + then ⌘⇧G and paste"
  echo "     $APP"
  echo
  echo "   Then: dictate stop && dictate start    (grants are read at startup only)"
  ;;

doctor)
  fail=0
  chk() { if [ "$1" = 0 ]; then printf '  ✓ %s\n' "$2"; else printf '  ✗ %s\n' "$2"; fail=1; fi; }
  echo "binaries"
  for b in whisper-server whisper-cli ffmpeg swiftc; do
    command -v "$b" >/dev/null; chk $? "$b$([ -z "$(command -v $b)" ] && echo ' — brew install whisper-cpp ffmpeg')"
  done
  for b in llama-server jq; do
    command -v "$b" >/dev/null; chk $? "$b$([ -z "$(command -v $b)" ] && echo ' — brew install llama.cpp') (right ⌘ refine path)"
  done
  echo "assets"
  [ -f "$MODEL" ]; chk $? "model ($([ -f "$MODEL" ] && du -h "$MODEL" | cut -f1 || echo 'missing — see README'))"
  [ -f "$REFINE_MODEL" ]; chk $? "refine model ($([ -f "$REFINE_MODEL" ] && du -h "$REFINE_MODEL" | cut -f1 || echo 'missing — dictate pull-model'))"
  [ -x "$APP/Contents/MacOS/dictate-daemon" ]; chk $? "daemon binary (dictate build)"
  echo "privacy"
  # core.hooksPath is local config, so a fresh clone has the hook file but not the
  # hook. Checked here because a silently inactive guard is worse than none — it
  # is the one that gets trusted.
  [ "$(git -C "$DIR" config core.hooksPath 2>/dev/null)" = ".githooks" ]
  chk $? "pre-commit guard active (git -C '$DIR' config core.hooksPath .githooks)"
  ! git -C "$DIR" ls-files --error-unmatch takes >/dev/null 2>&1
  chk $? "no takes/ tracked by git"
  echo "runtime"
  pgrep -f "dictate-daemon" >/dev/null; chk $? "daemon running (dictate start)"
  server_up; chk $? "whisper-server on :$PORT"
  refine_up; chk $? "llama-server on :$REFINE_PORT (right ⌘ pastes raw without it)"
  # The daemon is the only process that can observe its own TCC grants; it logs them
  # at startup, so doctor reports what the black box last saw.
  # A running process cannot see a TCC toggle flipped after it launched, so these are
  # necessarily a snapshot. Print when it was taken — a stale ✗ after you just granted
  # something is the single most confusing thing this tool can show you.
  started=$(grep "root:" "$LOG" 2>/dev/null | tail -1 | cut -d'.' -f1 | tr 'T' ' ')
  stale=0
  echo "permissions (read at daemon start, ${started:-unknown})"
  for svc in accessibility microphone "input monitoring"; do
    line=$(grep -i "^.*$svc:" "$LOG" 2>/dev/null | tail -1)
    # Negative cases first: "NOT trusted" contains "trusted".
    case "$line" in
      "") printf '  ? %s — no record, run: dictate start\n' "$svc"; fail=1 ;;
      *NOT\ trusted*|*DENIED*|*"not yet"*) printf '  ✗ %s\n' "$(printf '%s' "${line#* }" | cut -c1-72)"; fail=1; stale=1 ;;
      *granted*|*trusted*) printf '  ✓ %s\n' "$svc" ;;
      *) printf '  ✗ %s\n' "$(printf '%s' "${line#* }" | cut -c1-72)"; fail=1; stale=1 ;;
    esac
  done
  [ "$stale" = 1 ] && echo "  ↻ already flipped the toggle? this snapshot predates it: dictate stop && dictate start"
  [ "$fail" = 0 ] && echo "all good" || echo "→ fix the ✗ lines above"
  exit "$fail"
  ;;

test)
  pass=0; fail=0
  while IFS="$TAB" read -r raw want; do
    case "$raw" in \#*|"") continue ;; esac
    got=$(printf '%s' "$raw" | sh "$DIR/clean.sh")
    if [ "$got" = "$want" ]; then
      pass=$((pass+1))
    else
      fail=$((fail+1))
      printf '  FAIL  in:   %s\n        want: %s\n        got:  %s\n' "$raw" "$want" "$got"
    fi
  done < "$DIR/tests/replacements.tsv"
  echo "$pass passed, $fail failed"
  [ "$fail" = 0 ] || exit 1
  ;;

refine-test)
  refine_up || { echo "llama-server not running — dictate start (or: dictate pull-model)"; exit 1; }
  pass=0; fail=0
  # The passthrough floor is the safety property, so it is asserted first and by
  # identity: below the floor the text must come back byte-for-byte, because an LLM
  # given a near-empty utterance invents a whole request instead of declining.
  for short in "um" "Testing, testing." "." "Holding option works."; do
    got=$(printf '%s' "$short" | sh "$DIR/refine.sh" 2>/dev/null)
    if [ "$got" = "$short" ]; then pass=$((pass+1)); else
      fail=$((fail+1)); printf '  FAIL  short input was not passed through\n        in:   %s\n        got:  %s\n' "$short" "$got"
    fi
  done

  while IFS="$TAB" read -r input want reject; do
    case "$input" in \#*|"") continue ;; esac
    got=$(printf '%s' "$input" | sh "$DIR/refine.sh" 2>/dev/null)
    bad=""
    OLDIFS=$IFS; IFS=';'
    for w in $want;   do [ -n "$w" ] && case "$got" in *"$w"*) ;; *) bad="$bad
        missing: $w" ;; esac; done
    for r in $reject; do [ -n "$r" ] && case "$got" in *"$r"*) bad="$bad
        should not contain: $r" ;; esac; done
    IFS=$OLDIFS
    if [ -z "$bad" ]; then pass=$((pass+1)); else
      fail=$((fail+1)); printf '  FAIL  in:   %s\n        got:  %s%s\n' "$input" "$got" "$bad"
    fi
  done < "$DIR/tests/refine.tsv"
  echo "$pass passed, $fail failed"
  [ "$fail" = 0 ] || exit 1
  ;;

bench)
  command -v whisper-server >/dev/null || { echo "whisper-cpp not installed — run: dictate doctor"; exit 1; }
  TMP="$DIR/.bench-tmp"; mkdir -p "$TMP"
  server_up || { echo "starting whisper-server (cold load ~10s)..."
    nohup whisper-server -m "$MODEL" --port "$PORT" --host 127.0.0.1 >> "$SERVERLOG" 2>&1 &
    until server_up; do sleep 0.2; done; }

  echo "transcription latency (resident model, Metal):"
  for n in 1 3 10; do
    phrase=""; i=0
    while [ "$i" -lt "$n" ]; do phrase="$phrase Restart the rosbag on tyler zero one and check the pinpoint odometry."; i=$((i+1)); done
    say -o "$TMP/b.aiff" "$phrase"
    ffmpeg -y -loglevel quiet -i "$TMP/b.aiff" -ar 16000 -ac 1 "$TMP/b.wav"
    dur=$(ffprobe -v quiet -show_entries format=duration -of csv=p=0 "$TMP/b.wav")
    sh "$DIR/transcribe.sh" "$TMP/b.wav" >/dev/null   # warm
    t0=$(python3 -c 'import time;print(time.time())')
    out=$(sh "$DIR/transcribe.sh" "$TMP/b.wav")
    t1=$(python3 -c 'import time;print(time.time())')
    python3 -c "print(f'  {$dur:5.1f}s audio -> {($t1-$t0)*1000:5.0f} ms  ({$dur/($t1-$t0):4.1f}x realtime)')"
    [ "$n" = 1 ] && echo "        transcript: $out"
  done

  if refine_up; then
    echo "refine latency (right ⌘ path, resident 7B on Metal):"
    # Distinct content per clause, not one clause repeated: a repeated clause condenses
    # to three words however long the input is, and reports a latency nobody will see.
    # Output length drives generation time, so the phrases have to carry real material.
    S="okay so can you like check the tests first and then uh look at the glossary thing"
    M="$S, and also I was thinking maybe we should restart the rosbag on tyler01 and see whether the pinpoint odometry still drifts after the ekf update lands"
    L="$M, and then after that please write up what we found in the log file, oh and don't touch main obviously, and if the drift is still there just revert the whole thing and we will look at it tomorrow instead"
    for v in S M L; do
      eval "phrase=\$$v"
      t0=$(python3 -c 'import time;print(time.time())')
      out=$(printf '%s' "$phrase" | sh "$DIR/refine.sh" 2>/dev/null)
      t1=$(python3 -c 'import time;print(time.time())')
      python3 -c "
i=len('''$phrase'''.split()); o=len('''$out'''.split())
print(f'  {i:3d} words in -> {($t1-$t0)*1000:5.0f} ms  ({o:3d} words out)')"
    done
  else
    echo "refine latency: skipped (llama-server not running)"
  fi

  echo "capture onset loss (speech lost before the first sample lands):"
  ffmpeg -y -loglevel quiet -f avfoundation -i ":default" -ar 16000 -ac 1 "$TMP/c.wav" & P=$!
  python3 -c "import time; time.sleep(1.5)"
  kill -INT "$P" 2>/dev/null; wait "$P" 2>/dev/null
  cap=$(ffprobe -v quiet -show_entries format=duration -of csv=p=0 "$TMP/c.wav")
  python3 -c "print(f'  ffmpeg subprocess (CLI path):  {(1.5-$cap)*1000:4.0f} ms')"
  # Runs the daemon's actual Recorder, so this row cannot drift from the shipped code.
  swiftc -O -parse-as-library "$DIR/daemon/Core.swift" "$DIR/daemon/Recorder.swift" \
      "$DIR/tests/capture-probe.swift" -o "$TMP/probe" 2>/dev/null \
    && "$TMP/probe" "$TMP/p.wav" | grep '^trial' | sed 's/^/  AVAudioEngine (daemon path): /' \
    || echo "  AVAudioEngine (daemon path): probe failed to build"
  rm -rf "$TMP"
  ;;

log)
  tail -f "$LOG"
  ;;

"")
  [ -f "$MODEL" ] || { echo "model missing — run: dictate doctor"; exit 1; }
  WAV="$DIR/.dictate-rec.wav"
  if ! server_up; then
    echo "loading model into whisper-server..."
    nohup whisper-server -m "$MODEL" --port "$PORT" --host 127.0.0.1 >> "$SERVERLOG" 2>&1 &
    until server_up; do sleep 0.2; done
  fi
  echo "dictate ready — transcripts print here AND land on the clipboard (⌘V anywhere)"
  while :; do
    printf '\n[Enter] record · [q] quit > '
    read -r k || exit 0; [ "$k" = "q" ] && exit 0
    # ":default" not ":0" — index 0 is whatever ffmpeg enumerated first, which changes
    # when you plug in an interface.
    ffmpeg -y -loglevel quiet -f avfoundation -i ":default" -ar 16000 -ac 1 "$WAV" &
    FPID=$!
    printf '🎤 recording... [Enter] stop > '
    read -r _
    kill -INT "$FPID" 2>/dev/null; wait "$FPID" 2>/dev/null
    txt="$(sh "$DIR/transcribe.sh" "$WAV")"
    if [ -n "$txt" ]; then printf '%s' "$txt" | pbcopy; printf '📋 %s\n' "$txt"; else echo "(no speech)"; fi
  done
  ;;

takes)
  # Retention of raw audio + pre-clean transcripts, for offline speech analysis.
  # Never on by default: this is the only thing here that persists microphone audio.
  TAKES="$DIR/takes"
  case "$2" in
    on)  mkdir -p "$TAKES" && touch "$TAKES/.enabled"
         echo "takes: ON — every transcribed utterance retains a .wav and pre-clean .txt"
         echo "       in $TAKES (gitignored, never committed)"
         echo "       ~290KB per take, ~67MB/day at measured usage. Nothing is ever"
         echo "       auto-deleted; check growth with: dictate takes status"
         echo "       off with: dictate takes off" ;;
    off) rm -f "$TAKES/.enabled"
         echo "takes: OFF — retention stopped. Everything already collected is kept." ;;
    ""|status)
         if [ -f "$TAKES/.enabled" ]; then s="ON"; else s="OFF"; fi
         n=$(ls "$TAKES"/*.wav 2>/dev/null | wc -l | tr -d ' ')
         sz=$(du -sh "$TAKES" 2>/dev/null | cut -f1); [ -n "$sz" ] || sz="0B"
         echo "takes: $s — $n retained, $sz in $TAKES"
         echo "       nothing is auto-deleted; free space: $(df -h "$DIR" | awk 'NR==2{print $4}')" ;;
    purge)
         # Explicit, confirmed, and never invoked by anything else. Retention exists
         # because these recordings are not reproducible; deleting them is a decision.
         n=$(ls "$TAKES"/*.wav 2>/dev/null | wc -l | tr -d ' ')
         [ "$n" -gt 0 ] || { echo "takes: nothing to purge"; exit 0; }
         echo "About to permanently delete $n take(s) ($(du -sh "$TAKES" 2>/dev/null | cut -f1)) from:"
         echo "  $TAKES"
         echo "These are microphone recordings and cannot be regenerated."
         printf 'Type DELETE to confirm: '
         read -r c
         [ "$c" = "DELETE" ] || { echo "takes: cancelled, nothing deleted"; exit 0; }
         rm -f "$TAKES"/*.wav "$TAKES"/*.txt
         echo "takes: purged $n take(s). Retention is still $([ -f "$TAKES/.enabled" ] && echo ON || echo OFF)." ;;
    *)   echo "usage: dictate takes [on|off|status|purge]"; exit 1 ;;
  esac
  ;;

prompting)
  # Measures whether Haider's prompting is improving, from the session logs plus
  # daemon.log. Not a dictation feature — it is the evidence base for whether the
  # two keys are earning their place, which is why it lives with them. Prints
  # markdown to paste under a new dated heading in PROMPTING_LOG.md.
  shift
  exec /usr/bin/python3 "$DIR/prompting-stats.py" "$@"
  ;;

help|-h|--help)
  cat <<'USAGE'
dictate — hold right ⌥, speak, release, text lands at the cursor. Fully local.
          right ⌘ does the same but restructures the speech first.

daemon
  start           launch the daemon (loads models; ~10s once, never on the hot path)
  stop            kill the daemon and both model servers
  build           recompile + re-sign, then restart. Re-toggle Accessibility after.
  log             tail daemon.log — one line per utterance, with per-stage ms

health
  doctor          binaries, models, servers, TCC grants, privacy guards
  permissions     the Accessibility / Input Monitoring re-grant dance, one command
  pull-model      fetch the 7B refine model for the right-⌘ path

text pipeline
  test            run tests/replacements.tsv through the real pipeline
  refine-test     assert refine.txt properties (requirements survive, filler does not)
  bench           per-stage latency table
  refine          pipe text in, get the restructured version out

analysis
  takes [on|off|status|purge]
                  retain audio + pre-clean transcripts in takes/ for offline
                  speech analysis. Off by default. Nothing is auto-deleted.
  prompting [--split]
                  measure prompting quality over time from the session logs

  (no arguments)  interactive terminal mode — Enter to record, transcript to stdout
USAGE
  ;;

*)
  echo "dictate: unknown command '$1'"
  echo "usage: dictate [start|stop|build|doctor|permissions|test|refine-test|bench|log|refine|prompting|takes|pull-model|help]"
  exit 1
  ;;
esac
